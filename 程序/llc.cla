/*
 * Four-mode control pure-computation verification.
 * Set both enable macros to 0 for normal hardware operation.
 * TPS_FORCE_MODE: 1=G1, 2=G2, 3=D1, 4=D2.
 */
#define TPS_LOGIC_TEST_MODE     0
#define TPS_FORCE_MODE_TEST     0
#define TPS_FORCE_MODE          0

#define TPS_TEST_V1             30.0f
#define TPS_TEST_V2             60.0f
#define TPS_TEST_VREF           60.0f
#define TPS_TEST_KP             0.0f
#define TPS_TEST_KI             0.0f

#define TPS_DEBUG_GROUP         6
#define TPS_AUTO_BUMPLESS_TEST  0
#define TPS_TEST_START_MODE     3
#define TPS_TEST_PI_OUTPUT      1.00f

/*********************************CLA 数据段配置**********************************/
// 通信变量指定存储到 CLA→CPU 通信RAM（CLA可读写，CPU只读）
#pragma DATA_SECTION(ClaToCpu,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(CLA_PARA,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(CLA_ULOOP,"Cla1ToCpuMsgRAM");
//#pragma DATA_SECTION(CLA_ILOOP,"Cla1ToCpuMsgRAM");
/* Internal control state belongs in CLA data RAM; keep message RAM for CPU-visible outputs. */
#pragma DATA_SECTION(CLA_TPS,"Cla1DataRam1");
#pragma DATA_SECTION(cmpa1_cmd,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(cmpa2_cmd,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(cmpa3_cmd,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(cmpa4_cmd,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(tbphs3_cmd,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(tbphs4_cmd,"Cla1ToCpuMsgRAM");
#pragma DATA_SECTION(phsdir_cmd,"Cla1ToCpuMsgRAM");
/*********************************核心结构体定义（保留指定内容，删除其他冗余）**********************************/
typedef struct{
     float dat[9];
}ClaToCpuData;
ClaToCpuData ClaToCpu;//cla到cpu

typedef struct{
    unsigned int From_CPU[8];
}ClaAdcData;
ClaAdcData CLA_PARA;//cpu到cla
uint32_t cmpa1_cmd;
uint32_t cmpa2_cmd;
uint32_t cmpa3_cmd;
uint32_t cmpa4_cmd;
uint32_t tbphs3_cmd;
